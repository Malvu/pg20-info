[Unit]
Description=Pg20 Info : réception des fiches d'installation (TLS, exposé à Internet sur TCP 21120)
After=network-online.target pg20-peers-export.service
Wants=network-online.target

[Service]
User=pg20-inbox
Group=pg20-inbox
Environment=PG20_INBOX_PORT=21120
LoadCredential=cert:/etc/pg20/inbox.crt
LoadCredential=key:/etc/pg20/inbox.key
StateDirectory=pg20-inbox
StateDirectoryMode=0770
UMask=0007
ExecStart=/usr/bin/python3 /usr/local/lib/pg20/inbox-receive.py
Restart=on-failure
RestartSec=5

# Isolation : ce service ne peut écrire que dans son dossier d'attente et ne lit que la liste des enregistrements
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/var/lib/pg20-peers
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallArchitectures=native
LimitNOFILE=256
TasksMax=64
MemoryMax=128M

[Install]
WantedBy=multi-user.target
